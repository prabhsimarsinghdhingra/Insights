# Copy to backend/.env (gitignored) and adjust. Never commit real values.

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Required in production. In development a random secret is generated per start.
JWT_SECRET=
JWT_EXPIRES_IN_SEC=3600
# Password shared by the three demo accounts. Default in development: PureInsights#2026
DEMO_PASSWORD=

# --- Data ---
# demo = in-memory from the CSV (no Snowflake needed); snowflake = live warehouse
DATA_SOURCE=demo
CREDIT_PRICE_USD=3
# Real-time replay: one monitoring reading is processed every N ms (admins can change speed live)
TELEMETRY_INTERVAL_MS=1000

# --- Snowflake (used when DATA_SOURCE=snowflake) ---
SNOWFLAKE_ACCOUNT=<orgname-accountname>      # e.g. ABCDEFG-XY12345
SNOWFLAKE_USER=PURE_INSIGHTS_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8      # key-pair auth, file stays local
SNOWFLAKE_ROLE=PURE_INSIGHTS_APP
SNOWFLAKE_WAREHOUSE=PURE_INSIGHTS_WH
SNOWFLAKE_DATABASE=PURE_INSIGHTS

