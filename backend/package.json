{
  "name": "pure-insights-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pure Insights Command Center - API, telemetry and data pipeline",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
